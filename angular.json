{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "website": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/website",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              {
                "glob": "LICENSE",
                "input": "node_modules/@fontsource/alegreya-sans",
                "output": "licenses/alegreya-sans"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": { "inlineCritical": false }
              },
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "250kB", "maximumError": "350kB" }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "defaultConfiguration": "development",
          "configurations": {
            "development": {
              "buildTarget": "website:build:development"
            }
          }
        }
      }
    }
  }
}
