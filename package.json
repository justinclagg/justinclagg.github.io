{
  "name": "justinclagg-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/finalize-build.mjs",
    "test": "playwright test",
    "preview": "node scripts/preview.mjs",
    "check": "npm run build && npm run build:dev && npm test && npm audit",
    "build:dev": "ng build --configuration development --output-path dist/website-dev"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.6",
    "@fontsource/alegreya-sans": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
